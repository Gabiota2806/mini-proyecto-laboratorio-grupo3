<?xml version="1.0"?>
<ruleset name="LaboratorioPedidosRuleset">
    <description>Reglas de codificacion PSR-12 para laboratorio-pedidos</description>

    <arg name="colors"/>
    <arg value="p"/>
    <arg name="extensions" value="php"/>

    <rule ref="PSR12">
        <!-- Permitir clases e interfaces sin namespace en src/ segun arquitectura hibrida -->
        <exclude name="PSR1.Classes.ClassDeclaration.MissingNamespace"/>
        <!-- Permitir estructuras de interfaces/estrategias en el mismo archivo del modulo -->
        <exclude name="PSR1.Classes.ClassDeclaration.MultipleClasses"/>
    </rule>

    <file>tests</file>
    <file>src/Pricing</file>
</ruleset>
