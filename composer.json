{
    "name": "mds2-utn/laboratorio-pedidos",
    "description": "Sistema de gestión de pedidos de laboratorio clínico - Metodología de Sistemas II (UTN FRRe)",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "classmap": [
            "src/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "squizlabs/php_codesniffer": "^3.9",
        "phpstan/phpstan": "^1.11"
    },
    "scripts": {
        "test": "phpunit --testdox",
        "cs": "phpcs",
        "cs-fix": "phpcbf",
        "stan": "phpstan analyse",
        "check": [
            "@cs",
            "@stan",
            "@test"
        ]
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "allow-plugins": {}
    }
}
